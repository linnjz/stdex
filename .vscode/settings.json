  // ==================== 20. Path Intellisense ====================
  "path-intellisense.autoSlashAfterDirectory": true, // 目录后自动加斜杠
  "path-intellisense.ignoreTsConfigBaseUrl": true, // 忽略 tsconfig baseUrl
  // ==================== 21. Chat & AI ====================
  "chat.disableAIFeatures": true, // 禁用 AI 功能
