      },
      {
        // lambda [](){}
        "scope": [
          "punctuation.definition.capture.begin.lambda.cpp",
          "punctuation.definition.capture.end.lambda.cpp",
          "punctuation.section.block.begin.bracket.curly.lambda.cpp",
          "punctuation.section.block.end.bracket.curly.lambda.cpp"
        ],
        "settings": {
          "foreground": "#2C5187"
        }
      },
      {
        // 属性 [[]]
        "scope": [
          "entity.other.attribute.$0.cpp",
          "punctuation.section.attribute.begin.cpp",
          "punctuation.section.attribute.end.cpp",
          "support.other.attribute.cpp"
        ],
        "settings": {
          "foreground": "#1781B5"
        }
      },
      {
        // 初始化 {}
        "scope": [
          "punctuation.section.arguments.begin.bracket.curly.initializer.cpp",
          "punctuation.section.arguments.end.bracket.curly.initializer.cpp",
        ],
        "settings": {
          "foreground": "#2C5187"
        }
      },
      {
        // 结构化绑定 [...]
        "scope": [
          "meta.binding.cpp",
          "punctuation.definition.begin.bracket.square.binding.cpp",
          "punctuation.definition.end.bracket.square.binding.cpp",
        ],
        "settings": {
          "foreground": "#000000"
        }
      },
      // 15. 汇编与杂项 (Assembly & Miscellaneous)
      {
        // 汇编
        "scope": [
          "meta.embedded.assembly",
          "meta.asm.cpp",
        ],
        "settings": {
          "foreground": "#0000EE"
        }
      },
      {
        //行继续转义
        "scope": [
          "constant.character.escape.line-continuation.cpp",
        ],
        "settings": {
          "foreground": "#90A4AE"
        }
      },
      {
        // 非法语法着色
        "scope": [
          "invalid.illegal.unknown-escape.cpp",
          "invalid.illegal.constant.numeric.cpp"
        ],
        "settings": {
          "foreground": "#C62828",
        }
      },
    ]
  },
  // ==================== 9. clangd ====================
  "clangd.arguments": [
    "--header-insertion=never",
    "--background-index",
    "--pch-storage=memory",
    "--limit-results=50",
    "--limit-references=1000",
    "-j=4"
  ],
  "clangd.fallbackFlags": [
    "-std=c++23",
    "-g",
    "-lpthread"
  ], // 无编译数据库时的回退标志
  "clangd.onConfigChanged": "restart", // 配置文件变更时重启
  // ==================== 10. LLDB 调试器 ====================
  "lldb.evaluateForHovers": true, // 悬停显示变量值
  "lldb.dereferencePointers": true, // 指针显示解引用值
  "lldb.displayFormat": "auto", // 变量显示格式
  "lldb.suppressMissingSourceFiles": true, // 隐藏缺失源文件提示
  "lldb.commandCompletions": true, // 调试控制台命令补全
  "lldb.consoleMode": "commands", // 控制台默认调试命令模式
  "lldb.evaluationTimeout": 10, // 表达式求值超时(秒)
  // ==================== 11. CMake 工具集成 (CMake) ====================
  "cmake.additionalBuildProblemMatchers": [], // 额外构建问题匹配器
  "cmake.allowCommentsInPresetsFile": true, // 允许 CMakePresets.json 注释
  "cmake.buildBeforeRun": true, // 运行前先构建
  "cmake.clearOutputBeforeBuild": true, // 构建前清输出
  "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json", // 导出 compile_commands.json
  "cmake.enabledOutputParsers": [
    "cmake",
    "gcc",
    "msvc"
  ], // 输出解析器
  "cmake.modifyLists.addNewSourceFiles": "ask", // 新建文件自动更新 CMakeLists.txt
  "cmake.modifyLists.removeDeletedSourceFiles": "ask", // 删除文件自动清理 CMakeLists.txt
  "cmake.parallelJobs": 0, // 并行作业数(0=自动)
  "cmake.parseBuildDiagnostics": true, // 解析编译器输出
  "cmake.saveBeforeBuild": true, // 构建前保存文件
  "cmake.ctest.testExplorerIntegrationEnabled": true, // 测试资源管理器集成
  // ==================== 12. Code Runner ====================
  "code-runner.clearPreviousOutput": true, // 每次运行前清空输出
  "code-runner.fileDirectoryAsCwd": true, // 以文件所在目录为工作目录
  "code-runner.ignoreSelection": true, // 始终运行整个文件
  "code-runner.runInTerminal": true, // 在终端运行（支持交互输入）
  "code-runner.saveAllFilesBeforeRun": true, // 运行前自动保存
  "code-runner.preserveFocus": false, // 运行后焦点切到终端
  "code-runner.respectShebang": true, // 尊重 #! 解释器指令
  // ==================== 13. Doxygen 文档生成 (doxdocgen) ====================
  // 命令风格
  "doxdocgen.generic.commandSuggestionAddPrefix": true, // 命令建议加 @ 前缀
  // 文件头
  "doxdocgen.file.fileOrder": [
    "file",
    "author",
    "brief",
    "version",
    "date",
    "empty",
    "copyright",
    "empty",
    "custom"
  ],
  "doxdocgen.file.copyrightTag": [
    "@copyright Copyright (c) {year}"
  ],
  "doxdocgen.file.versionTag": "@version 0.1",
  "doxdocgen.file.fileTemplate": "@file {name}",
  // 作者信息
  "doxdocgen.generic.authorName": "your name",
  "doxdocgen.generic.authorEmail": "your@email.com",
  "doxdocgen.generic.authorTag": "@author {author} ({email})",
  // 日期
  "doxdocgen.generic.dateFormat": "YYYY-MM-DD",
  "doxdocgen.generic.dateTemplate": "@date {date}",
  // 注释模板
  "doxdocgen.generic.briefTemplate": "@brief {text}",
  "doxdocgen.generic.paramTemplate": "@param {param} ",
  "doxdocgen.generic.returnTemplate": "@return {type} ",
  "doxdocgen.cpp.tparamTemplate": "@tparam {param} ",
  // 注释块顺序
  "doxdocgen.generic.order": [
    "brief",
    "empty",
    "tparam",
    "param",
    "return",
    "custom"
  ],
  // C 风格注释
  "doxdocgen.c.firstLine": "/**",
  "doxdocgen.c.lastLine": " */",
  "doxdocgen.c.commentPrefix": " * ",
  // 智能文本
  "doxdocgen.generic.boolReturnsTrueFalse": true,
  "doxdocgen.cpp.ctorText": "Construct a new {name} object",
  "doxdocgen.cpp.dtorText": "Destroy the {name} object",
  // ==================== 14. Markdown All in One ====================
  "markdown.extension.completion.enabled": true, // 路径补全
  "markdown.extension.showActionButtons": true, // 工具栏按钮
  "markdown.extension.preview.autoShowPreviewToSide": true, // 自动预览
  "markdown.extension.tableFormatter.enabled": true, // 表格格式化
  "markdown.extension.tableFormatter.delimiterRowNoPadding": true, // 表格分隔线填满
  "markdown.extension.toc.levels": "2..4", // 目录级别范围
  "markdown.extension.math.enabled": true, // 数学公式
  "markdown.extension.print.onFileSave": false, // 保存不自动打印
  // ==================== 15. Markdown Preview Enhanced ====================
  "markdown-preview-enhanced.automaticallyShowPreviewOfMarkdownBeingEdited": true, // 自动预览
  "markdown-preview-enhanced.breakOnSingleNewLine": true, // GFM 换行
  "markdown-preview-enhanced.enablePreviewZenMode": true, // 精简 UI
  "markdown-preview-enhanced.previewTheme": "github-light.css", // 预览主题
  "markdown-preview-enhanced.codeBlockTheme": "auto.css", // 代码块主题自动匹配
  "markdown-preview-enhanced.enableEmojiSyntax": true, // Emoji
  "markdown-preview-enhanced.enableWikiLinkSyntax": true, // Wiki 链接
  "markdown-preview-enhanced.enableTagSyntax": true, // Obsidian 标签
  "markdown-preview-enhanced.enableImageLightbox": true, // 图片灯箱
  "markdown-preview-enhanced.scrollSync": true, // 同步滚动
  "markdown-preview-enhanced.liveUpdate": true, // 实时更新预览
  "markdown-preview-enhanced.mathRenderingOption": "KaTeX", // 数学渲染
  "markdown-preview-enhanced.hideDefaultVSCodeMarkdownPreviewButtons": true, // 隐藏自带预览按钮
  // ==================== 16. markdownlint ====================
  "markdownlint.focusMode": true, // 输入时隐藏附近 lint
  "markdownlint.run": "onType", // 输入时检查
  "markdownlint.config": {
    "MD013": false, // 关闭行长度限制
    "MD033": false, // 允许内联 HTML
    "MD024": false, // 允许重复标题
    "MD046": false // 允许不同代码块风格
  },
  // ==================== 17. Color Highlight ====================
  "color-highlight.enable": true, // 启用颜色高亮
  "color-highlight.languages": [
    "*"
  ], // 所有语言
  "color-highlight.markerType": "background", // 背景高亮
  "color-highlight.markRuler": true, // 滚动条上显示颜色
  "color-highlight.matchWords": true, // 高亮颜色关键词
  "color-highlight.matchRgbWithNoFunction": true, // 高亮 RGB 无函数写法
  "color-highlight.matchHslWithNoFunction": true, // 高亮 HSL 无函数写法
  // ==================== 18. Error Lens ====================
  "errorLens.enabled": true, // 启用行内错误显示
  "errorLens.enabledDiagnosticLevels": [
    "error",
    "warning",
    "info",
    "hint"
  ], // 显示所有级别
  "errorLens.messageEnabled": true, // 显示错误消息
  "errorLens.messageBackgroundMode": "line", // 整行背景高亮
  "errorLens.gutterIconsEnabled": true, // 行号左侧图标
  "errorLens.statusBarIconsEnabled": true, // 状态栏错误计数
  "errorLens.statusBarMessageEnabled": true, // 状态栏错误消息
  "errorLens.fontWeight": "bold", // 加粗
  "errorLens.removeLinebreaks": true, // 多行合并为一行
  "errorLens.onSave": false, // 实时更新
  "errorLens.followCursor": "allLines", // 所有行显示
  // ==================== 19. cSpell (拼写检查) ====================
  "cSpell.autocorrect": true, // 自动修正键入错误
  "cSpell.fixSpellingWithRenameProvider": true, // 重命名修复拼写
  "cSpell.showSuggestionsLinkInEditorContextMenu": true, // 右键菜单显示建议
  "cSpell.diagnosticLevel": "Warning", // 问题面板可见度, Hint, Warning
  "cSpell.minWordLength": 4, // 检查 n 字母以上
  "cSpell.customDictionaries": { // 项目词库
    "project-words": {
      "name": "project-words",
      "path": "${workspaceRoot}/.cspell/project-words.txt",
      "addWords": true,
      "description": "Project-specific words"
