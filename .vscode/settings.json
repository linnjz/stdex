{
  // ==================== 1. 编辑器外观 (Editor Appearance) ====================
  "editor.colorDecorators": true, // 显示颜色装饰器（如颜色预览）
  "editor.fontFamily": "JetBrains Mono NL Light", // 字体
  "editor.fontSize": 18, // 字号
  "editor.fontLigatures": false, // 关闭连字
  "editor.glyphMargin": true, // 显示行号左侧的图标边栏
  "editor.lineNumbers": "on", // 显示行号
  "editor.minimap.enabled": true, // 启用缩略图
  "editor.minimap.renderCharacters": true, // 缩略图中渲染实际字符
  "workbench.preferredDarkColorTheme": "Visual Studio Light", // 工作台主题
  "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-light",
  "workbench.colorTheme": "JetBrains Rider New UI Lighter",
  "workbench.editor.useModal": "off",
  "workbench.experimental.modernUI": true,
  // ==================== 2. 编辑器交互 (Editor Interaction) ====================
  "editor.autoClosingBrackets": "always", // 自动闭合括号
  "editor.cursorBlinking": "smooth", // 光标闪烁样式
  "editor.foldOnOpen": false, // 打开文件时不自动折叠
  "editor.folding.enabled": true, // 启用代码折叠
  "editor.foldingStrategy": "indentation", // 基于缩进折叠
  "editor.guides.bracketPairs": true, // 括号对参考线
  "editor.matchBrackets": "always", // 高亮匹配括号
  "editor.mouseWheelZoom": true, // Ctrl+滚轮缩放字体
  "editor.scrollBeyondLastLine": false, // 禁止滚动超过最后一行
  "editor.showFoldingControls": "always", // 始终显示折叠按钮
  "editor.suggestOnTriggerCharacters": true, // 触发字符时弹出建议
  "editor.wordBasedSuggestions": "matchingDocuments", // 基于文档单词提供建议
  "editor.inlayHints.enabled": "offUnlessPressed",
  // ==================== 3. 格式化和缩进 (Formatting & Indentation) ====================
  "editor.detectIndentation": false, // 不自动检测缩进
  "editor.formatOnPaste": true, // 粘贴时格式化
  "editor.formatOnSave": true, // 保存时格式化
  "editor.formatOnType": false, // 输入时不格式化
  "editor.insertSpaces": true, // 使用空格缩进
  "editor.tabSize": 2, // 缩进 2 空格
  "editor.trimAutoWhitespace": false, // 保存时不自动删除行尾空白
  // ==================== 4. 文件与换行 (Files & Wrapping) ====================
  "editor.insertFinalNewline": true, // 文件末尾插入空行
  "editor.wrapText": false, // 文本不换行
  "files.eol": "\n", // 换行符 LF
  "files.trimTrailingWhitespace": true,  // 删除尾部空格
  // ==================== 5. 差异编辑器 (Diff Editor) ====================
  "diffEditor.codeLens": true, // 差异编辑器中显示代码透镜
  "diffEditor.renderSideBySide": true, // 差异对比分栏显示
  // ==================== 6. Git 集成与 GitLens (Git Integration & GitLens) ====================
  "scm.diffDecorations": "all", // Git 修改标记: all=装订线+滚动条, gutter=仅装订线, overview=仅滚动条, none=关闭
  "git.diffDecorationsGutterWidth": 3, // 装订线修改标记宽度 (1~5)
  "git.diffDecorationsGutterVisibility": "always", // 装订线标记显示时机: always/hover/active
  "git.decorations.enabled": true, // 文件树显示 M/U/A 标记
  "gitlens.ai.model": "gitkraken",
  "gitlens.ai.gitkraken.model": "gemini:gemini-2.5-flash",
  "gitlens.hovers.currentLine.over": "line",
  "workbench.colorCustomizations": {
    // Gutter indicators (left)
    "editorGutter.modifiedBackground": "#00c3ff",
    "editorGutter.addedBackground": "#e6ff05",
    "editorGutter.deletedBackground": "#ff0af3",
    // Scrollbar indicators (right)
    "editorOverviewRuler.addedForeground": "#ff5100",
    "editorOverviewRuler.modifiedForeground": "#003cff",
    "editorOverviewRuler.deletedForeground": "#ff0505"
  },
  // ==================== 7. C++ 语义着色 (Semantic Token Colors) ====================
  "editor.semanticHighlighting.enabled": false, // 语义高亮
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "templateType:cpp": {
        "foreground": "#1781B5"
      },
      "enumMember:cpp": {
        "foreground": "#000000"
      },
      "function:cpp": {
        "foreground": "#8E44AD"
      },
      "templateFunction:cpp": {
        "foreground": "#8E44AD"
      },
      "genericType:cpp": {
        "foreground": "#1781B5"
      },
      "macro:cpp": {
        "foreground": "#8A1BFF"
      },
      "method:cpp": {
        "foreground": "#8E44AD"
      },
      "type:cpp": {
        "foreground": "#1781B5"
      },
      "valueType:cpp": {
        "foreground": "#1781B5"
      },
      "type.deduced:cpp": {
        "foreground": "#0000EE"
      },
      "type.builtin:cpp": {
        "foreground": "#0000EE"
      },
      "variable.global:cpp": {
        "foreground": "#000000"
      },
      "variable.local:cpp": {
        "foreground": "#000000"
      },
      "variable.readonly:cpp": {
        "foreground": "#000000"
      }
      /*
      "event:cpp": {
        "foreground": "#000000"
      },
      "label:cpp": {
        "foreground": "#000000"
      },
      "property:cpp": {
        "foreground": "#000000"
      },
      "namespace:cpp": {
        "foreground": "#000000"
      },
      "newOperator:cpp": {
        "foreground": "#000000"
      },
      "operatorOverload:cpp": {
        "foreground": "#000000"
      },
      "memberOperatorOverload:cpp": {
        "foreground": "#000000"
      },
      "parameter:cpp": {
        "foreground": "#000000"
      },
      "cliProperty:cpp": {
        "foreground": "#000000"
      },
      "referenceType:cpp": {
        "foreground": "#000000"
      },
      "property.static:cpp": {
        "foreground": "#000000"
      },
      "method.static:cpp": {
        "foreground": "#000000"
      },
      "numberLiteral:cpp": {
        "foreground": "#000000"
      },
      "customLiteral:cpp": {
        "foreground": "#000000"
      },
      "stringLiteral:cpp": {
        "foreground": "#000000"
      }*/
    }
  },
  // ==================== 8. TextMate 语法着色 (Token Color Customizations) ====================
